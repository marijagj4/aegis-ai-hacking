# Default: every model call stays on this computer through Ollama.
AEGIS_ANALYSIS_PROVIDER=ollama
AEGIS_GUARD_MODEL=llama3.2:3b
AEGIS_TRIAGE_MODEL=llama3.2:1b
AEGIS_ANALYSIS_MODEL=llama3.2:3b
AEGIS_ANALYSIS_PROVIDER=openrouter
OPENROUTER_API_KEY=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
AEGIS_ANALYSIS_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Optional OpenRouter final-analysis provider.
# Copy this file to .env, then uncomment and set a model slug from your account.
# Never paste your API key into the dashboard, source code, report, or GitHub.
# AEGIS_ANALYSIS_PROVIDER=openrouter
# AEGIS_ANALYSIS_MODEL=provider/model-name
# OPENROUTER_API_KEY=your-key-here

# Optional native-Defender-safe Metasploit catalog fallback.
# First pull the official image manually; AEGIS itself never downloads it.
# AEGIS_METASPLOIT_CATALOG_BACKEND=docker
# AEGIS_METASPLOIT_DOCKER_IMAGE=metasploitframework/metasploit-framework:latest
